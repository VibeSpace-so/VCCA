{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": ".output",
    "rootDir": "."
  },
  "include": ["agent/**/*.ts", "adapters/**/*.ts"],
  "exclude": ["node_modules", ".output", ".eve"]
}
